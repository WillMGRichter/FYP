// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GitHubEntityType {
  REPOSITORY
  ISSUE
  PULL_REQUEST
  COMMIT
}

enum CollectionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Account {
  id               String                @id @default(cuid())
  email            String                @unique
  displayName      String
  passwordHash     String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         AccountSession[]
  githubTokens     GitHubToken[]
  collectionRuns   CollectionRun[]
  starredRepos     StarredRepository[]
  contributions    AccountContribution[]
}

model AccountSession {
  id        String   @id @default(cuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model GitHubToken {
  id             String          @id @default(cuid())
  accountId      String?
  label          String
  githubLogin    String?
  githubUserId   BigInt?
  encryptedToken String
  tokenPreview   String
  scopes         String[]
  rateLimit      Int?
  rateRemaining  Int?
  rateResetAt    DateTime?
  lastValidatedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  account        Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  collectionRuns CollectionRun[]

  @@index([accountId])
  @@index([githubLogin])
}

model Repository {
  id               String           @id @default(cuid())
  githubId         BigInt           @unique
  owner            String
  name             String
  fullName         String           @unique
  htmlUrl          String
  description      String?
  defaultBranch    String?
  isPrivate        Boolean          @default(false)
  isFork           Boolean          @default(false)
  language         String?
  stars            Int              @default(0)
  forks            Int              @default(0)
  openIssues       Int              @default(0)
  pushedAt         DateTime?
  githubCreatedAt  DateTime?
  githubUpdatedAt  DateTime?
  collectedAt      DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  artifacts        RepositoryArtifact[]
  snapshots        EntitySnapshot[]
  collectionRuns   CollectionRun[]
  starredBy        StarredRepository[]
  contributions    AccountContribution[]

  @@index([owner, name])
  @@index([language])
}

model RepositoryArtifact {
  id              String           @id @default(cuid())
  repositoryId    String
  type            GitHubEntityType
  githubNodeId    String?
  githubNumber    Int?
  githubSha       String?
  title           String?
  state           String?
  authorLogin     String?
  htmlUrl         String?
  mergedAt        DateTime?
  closedAt        DateTime?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?
  collectedAt     DateTime         @default(now())
  repository      Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshots       EntitySnapshot[]

  @@unique([repositoryId, type, githubNodeId])
  @@index([repositoryId, type])
  @@index([authorLogin])
}

model EntitySnapshot {
  id              String              @id @default(cuid())
  repositoryId    String
  artifactId      String?
  entityType      GitHubEntityType
  source          String
  payload         Json
  payloadHash     String
  capturedAt      DateTime            @default(now())
  collectionRunId String?
  repository      Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  artifact        RepositoryArtifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  collectionRun   CollectionRun?      @relation(fields: [collectionRunId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, artifactId, entityType, payloadHash])
  @@index([repositoryId, entityType])
  @@index([capturedAt])
}

model CollectionRun {
  id            String           @id @default(cuid())
  accountId     String?
  repositoryId  String?
  tokenId       String?
  status        CollectionStatus @default(PENDING)
  source        String           @default("github_api")
  requestedBy   String?
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  errorMessage  String?
  issuesCount   Int              @default(0)
  pullsCount    Int              @default(0)
  commitsCount  Int              @default(0)
  account       Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  repository    Repository?      @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  token         GitHubToken?     @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  snapshots     EntitySnapshot[]

  @@index([accountId])
  @@index([status])
  @@index([startedAt])
}

model StarredRepository {
  id           String     @id @default(cuid())
  accountId    String
  repositoryId String
  note         String?
  createdAt    DateTime   @default(now())
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([accountId, repositoryId])
  @@index([repositoryId])
}

model AccountContribution {
  id             String     @id @default(cuid())
  accountId      String
  repositoryId   String
  githubLogin    String
  commitsCount   Int        @default(0)
  issuesCount    Int        @default(0)
  pullsCount     Int        @default(0)
  lastObservedAt DateTime?
  updatedAt      DateTime   @updatedAt
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([accountId, repositoryId, githubLogin])
  @@index([accountId])
  @@index([githubLogin])
}
